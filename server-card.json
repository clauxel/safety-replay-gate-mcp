{
  "name": "safetyreplaygate",
  "title": "Safety Replay Gate",
  "description": "Safety Replay Gate lets agents run policy fixtures, return structured release verdicts, and archive safety receipts for review.",
  "version": "1.0.0",
  "websiteUrl": "https://safetyreplay.clauxel.com/",
  "documentationUrl": "https://safetyreplay.clauxel.com/mcp/",
  "endpointUrl": "https://safetyreplay.clauxel.com/mcp",
  "transport": "streamable-http",
  "authentication": {
    "type": "bearer",
    "required": true,
    "header": "Authorization",
    "format": "Bearer <paid-token>"
  },
  "paidAccess": {
    "required": true,
    "checkoutUrl": "https://safetyreplay.clauxel.com/api/agent-checkout",
    "tokenStatusUrl": "https://safetyreplay.clauxel.com/api/mcp-token/status",
    "tokenClaimUrl": "https://safetyreplay.clauxel.com/api/mcp-token/claim",
    "defaultPlan": "team",
    "pricing": [
      {
        "id": "starter",
        "name": "Starter",
        "monthlyUsd": 49
      },
      {
        "id": "team",
        "name": "Team",
        "monthlyUsd": 149
      },
      {
        "id": "governance",
        "name": "Governance",
        "monthlyUsd": 399
      }
    ]
  },
  "tools": [
    {
      "name": "run_safety_replay",
      "description": "Safety Replay Gate run safety replay",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sample": {
            "type": "string",
            "description": "Workflow sample, schema, policy fixture, or agent output."
          },
          "context": {
            "type": "string",
            "description": "Optional review context."
          }
        },
        "required": [
          "sample"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "receipt_id": {
            "type": "string"
          },
          "usage_units": {
            "type": "integer"
          },
          "next_action": {
            "type": "string"
          }
        }
      }
    },
